# Copy to .env for local development. Never commit the real .env.
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=true
# Leave unset to use a local SQLite file at backend/instance/database.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Optional: first owner login for the legacy company
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=
